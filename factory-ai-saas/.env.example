# 应用环境配置
NODE_ENV=development
PORT=3000

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=factory
DB_PASSWORD=factory123456
DB_DATABASE=factory_ai_platform

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=factory123456
REDIS_DB=0

# RabbitMQ配置
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=factory
RABBITMQ_PASSWORD=factory123456
RABBITMQ_VHOST=/factory

# JWT配置
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=30d

# 多租户配置
MULTI_TENANT_ENABLED=true

# AI核价引擎配置
AI_PRICING_ENGINE_URL=http://localhost:8000
AI_PRICING_ENGINE_API_KEY=your-api-key

# 阿里云配置（生产环境使用）
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_REGION=
